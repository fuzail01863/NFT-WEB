# Hardhat / Root Project .env.example
# Copy to .env and fill in your values

# ── Deployment Wallet ─────────────────────────────────────────────────────────
# Your wallet's private key for deployment (NEVER COMMIT THIS!)
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# ── Sepolia RPC ───────────────────────────────────────────────────────────────
# Get a free RPC URL from Alchemy or Infura
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# OR
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# ── Etherscan ─────────────────────────────────────────────────────────────────
# For contract verification: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key

# ── NFT Metadata Base URI ─────────────────────────────────────────────────────
# This is used as the base for token URIs during deployment.
# Example: https://your-backend.com/api/metadata/
BASE_METADATA_URI=http://localhost:8000/api/metadata/

# ── Gas Reporter ─────────────────────────────────────────────────────────────
REPORT_GAS=true
COINMARKETCAP_API_KEY=
