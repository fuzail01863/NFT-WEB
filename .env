# Root Project .env — Hardhat configuration
# IMPORTANT: Never commit this file to version control

# Your deployer wallet private key (without 0x prefix)
# Get test ETH from: https://sepoliafaucet.com
PRIVATE_KEY=

# Sepolia RPC URL — get from Alchemy (https://dashboard.alchemy.com) or Infura
SEPOLIA_RPC_URL=

# Etherscan API key for contract verification
# Get from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# NFT Metadata base URI (your backend URL)
BASE_METADATA_URI=http://localhost:8000/api/metadata/

# Optional: Enable gas reporting
REPORT_GAS=false
